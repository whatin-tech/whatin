# ================================================================
# 🔒 WHATIN ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual Firebase keys.
# ================================================================

# --- 1. GL BAJAJ STUDENT AUTHENTICATION SYSTEM ---
VITE_GLBAJAJ_FIREBASE_API_KEY=YOUR_GLBAJAJ_API_KEY
VITE_GLBAJAJ_FIREBASE_AUTH_DOMAIN=YOUR_GLBAJAJ_AUTH_DOMAIN
VITE_GLBAJAJ_FIREBASE_PROJECT_ID=YOUR_GLBAJAJ_PROJECT_ID
VITE_GLBAJAJ_FIREBASE_STORAGE_BUCKET=YOUR_GLBAJAJ_STORAGE_BUCKET
VITE_GLBAJAJ_FIREBASE_MESSAGING_SENDER_ID=YOUR_GLBAJAJ_SENDER_ID
VITE_GLBAJAJ_FIREBASE_APP_ID=YOUR_GLBAJAJ_APP_ID
VITE_GLBAJAJ_FIREBASE_MEASUREMENT_ID=YOUR_GLBAJAJ_MEASUREMENT_ID

# --- 2. ADMIN PORTAL & FIRESTORE RESOURCES ---
VITE_ADMIN_FIREBASE_API_KEY=YOUR_ADMIN_API_KEY
VITE_ADMIN_FIREBASE_AUTH_DOMAIN=YOUR_ADMIN_AUTH_DOMAIN
VITE_ADMIN_FIREBASE_PROJECT_ID=YOUR_ADMIN_PROJECT_ID
VITE_ADMIN_FIREBASE_STORAGE_BUCKET=YOUR_ADMIN_STORAGE_BUCKET
VITE_ADMIN_FIREBASE_MESSAGING_SENDER_ID=YOUR_ADMIN_SENDER_ID
VITE_ADMIN_FIREBASE_APP_ID=YOUR_ADMIN_APP_ID
VITE_ADMIN_FIREBASE_MEASUREMENT_ID=YOUR_ADMIN_MEASUREMENT_ID

# --- 3. SITE ANALYTICS & TELEMETRY ---
VITE_ANALYTICS_FIREBASE_API_KEY=YOUR_ANALYTICS_API_KEY
VITE_ANALYTICS_FIREBASE_AUTH_DOMAIN=YOUR_ANALYTICS_AUTH_DOMAIN
VITE_ANALYTICS_FIREBASE_DATABASE_URL=YOUR_ANALYTICS_DB_URL
VITE_ANALYTICS_FIREBASE_PROJECT_ID=YOUR_ANALYTICS_PROJECT_ID
VITE_ANALYTICS_FIREBASE_STORAGE_BUCKET=YOUR_ANALYTICS_STORAGE_BUCKET
VITE_ANALYTICS_FIREBASE_MESSAGING_SENDER_ID=YOUR_ANALYTICS_SENDER_ID
VITE_ANALYTICS_FIREBASE_APP_ID=YOUR_ANALYTICS_APP_ID
